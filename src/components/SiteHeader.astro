---
const links = [{href:"/",label:"Home"},{href:"/pre-school/",label:"SWEEP Kidz"},{href:"/primary-school/",label:"SWEEP Academy"},{href:"/admissions/",label:"Admissions"},{href:"/fees/",label:"Fees & resources"},{href:"/gallery/",label:"Gallery"},{href:"/about/",label:"Our school"}];
const path = Astro.url.pathname;
---
<header class="site-header"><div class="topline"><div class="container topline-inner"><span>Christian education · Suideroord, Johannesburg</span><div class="topline-contact"><a href="tel:+27116805938">011 680 5938</a><span aria-hidden="true">·</span><a href="mailto:schools@sweeplife.co.za">schools@sweeplife.co.za</a></div></div></div><div class="container nav-wrap"><a class="brand" href="/" aria-label="SWEEP Schools home"><span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 40 40" fill="none"><path d="M7 10.5C12.4 8.4 17 9.1 20 11.6V31c-3.8-2.4-8.2-3.1-13-1.3V10.5Z" fill="white" fill-opacity=".98"/><path d="M33 10.5c-5.4-2.1-10-1.4-13 1.1V31c3.8-2.4 8.2-3.1 13-1.3V10.5Z" fill="#F39B83"/><path d="M20 12v19" stroke="#4C315E" stroke-width="1.6"/><path d="M10 15.5c2.3-.6 4.3-.3 6.2.7M10 20c2.3-.6 4.3-.3 6.2.7M30 15.5c-2.3-.6-4.3-.3-6.2.7M30 20c-2.3-.6-4.3-.3-6.2.7" stroke="#4C315E" stroke-width="1.2" stroke-linecap="round"/></svg></span><span class="brand-copy"><strong>SWEEP</strong><small>SCHOOLS</small></span></a><details class="mobile-menu"><summary aria-label="Open navigation menu"><span></span><span></span><span></span></summary><nav aria-label="Main navigation">{links.map((link)=><a href={link.href} aria-current={path===link.href?"page":undefined}>{link.label}</a>)}<a href="/parent-portal/">Parent portal</a><a class="button button-small" href="/admissions/">Enquire now <span aria-hidden="true">↗</span></a></nav></details><nav class="desktop-nav" aria-label="Main navigation">{links.map((link)=><a href={link.href} aria-current={path===link.href?"page":undefined}>{link.label}</a>)}<a class="portal-link" href="/parent-portal/">Parent portal</a><a class="button button-small" href="/admissions/">Enquire now <span aria-hidden="true">↗</span></a></nav></div></header>