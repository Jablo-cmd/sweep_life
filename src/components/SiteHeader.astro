---
const links = [{href:"/",label:"Home"},{href:"/pre-school/",label:"SWEEP Kidz"},{href:"/primary-school/",label:"SWEEP Academy"},{href:"/admissions/",label:"Admissions"},{href:"/fees/",label:"Fees & resources"},{href:"/gallery/",label:"Gallery"},{href:"/about/",label:"Our school"}];
const path = Astro.url.pathname;
---
<header class="site-header"><div class="topline"><div class="container topline-inner"><span>Christian education · Suideroord, Johannesburg</span><div class="topline-contact"><a href="tel:+27116805938">011 680 5938</a><span aria-hidden="true">·</span><a href="mailto:schools@sweeplife.co.za">schools@sweeplife.co.za</a></div></div></div><div class="container nav-wrap"><a class="brand" href="/" aria-label="SWEEP Schools home"><span class="brand-mark" aria-hidden="true">S</span><span class="brand-copy"><strong>SWEEP</strong><small>SCHOOLS</small></span></a><details class="mobile-menu"><summary aria-label="Open navigation menu"><span></span><span></span><span></span></summary><nav aria-label="Main navigation">{links.map((link)=><a href={link.href} aria-current={path===link.href?"page":undefined}>{link.label}</a>)}<a href="/parent-portal/">Parent portal</a><a class="button button-small" href="/admissions/">Enquire now <span aria-hidden="true">↗</span></a></nav></details><nav class="desktop-nav" aria-label="Main navigation">{links.map((link)=><a href={link.href} aria-current={path===link.href?"page":undefined}>{link.label}</a>)}<a class="portal-link" href="/parent-portal/">Parent portal</a><a class="button button-small" href="/admissions/">Enquire now <span aria-hidden="true">↗</span></a></nav></div></header>