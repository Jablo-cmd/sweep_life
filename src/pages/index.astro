---
import BaseLayout from "../layouts/BaseLayout.astro";
const heroImage = "https://static.wixstatic.com/media/6d8eb9_5a52454d317b43a984f28740a8cd072a~mv2.jpg";
const kidzImage = "https://static.wixstatic.com/media/99c642_5a135c0b635f4c14a8a440947c9c6059~mv2.jpg";
const academyImage = "https://static.wixstatic.com/media/99c642_4c73b2c6d05246409950ce358ca4a322~mv2.jpg";
const galleryImages = [
 {src:"https://static.wixstatic.com/media/6d8eb9_6d91acefb903499f8054ad77b007e21b~mv2.jpg",alt:"A school gallery photograph showing the SWEEP community",label:"Life at SWEEP"},
 {src:"https://static.wixstatic.com/media/6d8eb9_3b8307d3cbde4b518387d7082ee32dfb~mv2.jpg",alt:"A moment from the SWEEP school community",label:"Our community"},
 {src:"https://static.wixstatic.com/media/6d8eb9_8087b3b328bd4e13b865545df154df87~mv2.jpg",alt:"A school activity at SWEEP",label:"Learning together"}
];
---
<BaseLayout title="Home" description="Discover SWEEP Kidz Pre-School and SWEEP Academy in Suideroord, Johannesburg, offering Christian education from early years through Grade 7.">
<section class="hero"><div class="hero-ornament" aria-hidden="true"></div><div class="container hero-grid"><div class="hero-copy"><span class="eyebrow">A foundation for the journey ahead</span><h1>Your child’s journey deserves a <em>strong beginning.</em></h1><p class="lead">Your child deserves the best possible experience to prepare them for their critical educational journey. At SWEEP Schools, we can help with the first 12 years of this life-changing journey.</p><div class="button-row"><a class="button" href="/admissions/">Explore admissions <span aria-hidden="true">↗</span></a><a class="button button-outline" href="/about/">Get to know SWEEP</a></div></div><div class="hero-visual"><img class="hero-image" src={heroImage} alt="Learners and school life at SWEEP Schools" fetchpriority="high" decoding="async" /><div class="image-note"><strong>Rooted in values.</strong>Growing in knowledge, confidence and character.</div></div></div></section>
<section class="trust-strip" aria-label="Our educational approach"><div class="container trust-items"><div class="trust-item"><span class="trust-icon" aria-hidden="true">✳</span><div><strong>Christian foundations</strong><small>Biblical principles guide our journey</small></div></div><div class="trust-item"><span class="trust-icon" aria-hidden="true">♡</span><div><strong>A caring environment</strong><small>Love, safety and belonging</small></div></div><div class="trust-item"><span class="trust-icon" aria-hidden="true">✦</span><div><strong>Whole-child development</strong><small>Spirit, soul and body</small></div></div></div></section>
<section class="section"><div class="container split"><div class="split-image-wrap"><img class="split-image" src={kidzImage} alt="SWEEP Kidz Pre-School, from the school's existing website" loading="lazy" decoding="async" /><div class="image-caption"><strong>Every stage matters</strong>Care that grows with your child</div></div><div class="split-copy"><span class="eyebrow">More than a school day</span><h2>A loving, caring and disciplined environment.</h2><p class="lead">SWEEP Schools embraces excellence in education while helping children grow, develop and achieve their true potential in spirit, soul and body.</p><p>Sound Biblical principles are at the foundation of our approach. We value the relationship between children, parents and staff, and the role each plays in a child’s educational journey.</p><a class="text-link" href="/about/">Discover our approach <span aria-hidden="true">→</span></a></div></div></section>
<section class="section phase-section"><div class="container"><div class="section-heading"><div><span class="eyebrow">Two phases, one journey</span><h2 style="margin-top:.8rem">A place for each stage of growing.</h2></div><p>From the early formative years through primary school, each phase supports the next step in your child’s development.</p></div><div class="phase-grid"><article class="phase-card"><img src={kidzImage} alt="SWEEP Kidz Pre-School" loading="lazy" decoding="async" /><div class="phase-card-body"><span class="card-kicker">Early years</span><h3>SWEEP Kidz Pre-School</h3><p>A warm, stimulating and friendly environment focused on physical, spiritual, emotional, social and cognitive development.</p><a class="text-link" href="/pre-school/">Discover SWEEP Kidz <span aria-hidden="true">→</span></a></div></article><article class="phase-card"><img src={academyImage} alt="SWEEP Academy Primary School" loading="lazy" decoding="async" /><div class="phase-card-body"><span class="card-kicker">Primary school</span><h3>SWEEP Academy</h3><p>An independent Christian primary school for Grade R to Grade 7, with education, care and supervision grounded in family values.</p><a class="text-link" href="/primary-school/">Discover SWEEP Academy <span aria-hidden="true">→</span></a></div></article></div></div></section>
<section class="section"><div class="container"><div class="section-heading"><div><span class="eyebrow">What guides us</span><h2 style="margin-top:.8rem">Learning with purpose. Growing with care.</h2></div><p>Our existing school message centres on helping every child develop as an individual, within a caring community and a Christian foundation.</p></div><div class="values-grid"><article class="value-card"><span class="value-number">01 / CARE</span><h3>A safe, loving environment</h3><p>A place where children and parents can feel comfortable, supported and part of the school community.</p></article><article class="value-card"><span class="value-number">02 / GROWTH</span><h3>Whole-child development</h3><p>Attention to physical, spiritual, emotional, social and cognitive development throughout the journey.</p></article><article class="value-card"><span class="value-number">03 / VALUES</span><h3>Sound Biblical principles</h3><p>A Christian foundation that shapes the values and decision-making approach at SWEEP Schools.</p></article></div></div></section>
<section class="quote-band section"><div class="container quote-grid"><div><span class="eyebrow" style="color:#e7c995">Our promise</span><div class="quote-mark" aria-hidden="true">“</div></div><div><blockquote><p>We promise to provide the highest quality education, care and supervision for all learners with the goal of assisting them to grow, develop and achieve their true potential in spirit, soul and body.</p></blockquote><cite>SWEEP Academy · Mission statement, copyedited for readability</cite></div></div></section>
<section class="section"><div class="container"><div class="section-heading"><div><span class="eyebrow">A glimpse of school life</span><h2 style="margin-top:.8rem">A community in motion.</h2></div><p>Explore moments from the existing SWEEP Schools gallery. Images are shown here as a layout preview and must be checked for reuse permissions before launch.</p></div><div class="gallery-grid">{galleryImages.map((item)=><figure class="gallery-tile"><img src={item.src} alt={item.alt} loading="lazy" decoding="async" /><figcaption>{item.label}</figcaption></figure>)}</div><p style="margin-top:1.5rem"><a class="text-link" href="/gallery/">Explore the gallery <span aria-hidden="true">→</span></a></p></div></section>
<section class="section" style="padding-top:0"><div class="container cta-band"><div><span class="eyebrow">Your next step</span><h2>Let’s talk about your child’s educational journey.</h2></div><a class="button" href="/admissions/">Admissions & enquiries <span aria-hidden="true">↗</span></a></div></section>
</BaseLayout>