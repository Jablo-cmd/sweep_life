---
import BaseLayout from "../layouts/BaseLayout.astro";

// Source URLs were discovered in the school's public gallery. The photographs
// have not yet been visually verified or cleared for reuse; captions and alt
// text remain deliberately neutral until the school confirms image context.
const images = [
  ["https://static.wixstatic.com/media/6d8eb9_2359c7052ffd4dfcadcc2e08da50d01f~mv2.jpg", "SWEEP Schools gallery photograph 1", "School life"],
  ["https://static.wixstatic.com/media/6d8eb9_68e8d8e0626b4000a4a6c113623f6e7d~mv2.jpg", "SWEEP Schools gallery photograph 2", "Our community"],
  ["https://static.wixstatic.com/media/6d8eb9_a9e50f8f104e47fdaae6b77a75896b3f~mv2.jpg", "SWEEP Schools gallery photograph 3", "Learning together"],
  ["https://static.wixstatic.com/media/6d8eb9_02f1013799284a8e95c5147547ec068f~mv2.jpg", "SWEEP Schools gallery photograph 4", "Everyday moments"]
];
---
<BaseLayout title="Gallery" description="Explore photographs from the SWEEP Schools community in Suideroord, Johannesburg. Image reuse and learner-photo consent must be confirmed before launch.">
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Life at SWEEP</span>
      <h1>Learning, growing<br />and belonging.</h1>
      <p>A glimpse of the people, activities and everyday moments that make up the SWEEP Schools community.</p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="fee-notice" style="margin-bottom:2rem">
        <strong>Preview note:</strong> These 4 image references were selected in the school's existing public gallery. The images have not yet been visually checked, locally optimised or cleared for reuse. Captions and descriptive alt text must be reviewed against each image, and consent for identifiable learners confirmed, before launch.
      </div>
      <div class="gallery-page-grid">
        {images.map(([src, alt, label]) => (
          <figure>
            <img src={src} alt={alt} loading="lazy" decoding="async" />
            <figcaption>{label}</figcaption>
          </figure>
        ))}
      </div>
      <p class="muted" style="margin-top:1.25rem">For admissions and school enquiries, please <a class="text-link" href="/contact/">contact SWEEP Schools <span aria-hidden="true">→</span></a>.</p>
    </div>
  </section>
</BaseLayout>
